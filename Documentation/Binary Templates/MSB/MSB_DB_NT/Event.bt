//------------------------------------------------

typedef struct {
    local quad start <hidden=true> = FTell();
    
    quad nameOffset <format=hex>; Assert(nameOffset);
    int eventNo; // -1
    EventType type;
    int typeIndex;
    int unk14;
    quad commonOffset <format=hex>; Assert(commonOffset);
    quad typeOffset <format=hex>;
    
    FSeek(start + nameOffset);
    wstring name;
    
    // Align: 8
    FSeek(start + commonOffset);
    EventCommon common;
    
    switch (type) {
        case EventTypeTreasure:
        case EventTypeGenerator:
        case EventTypeObjAct:
        case EventTypePlatoonInfo:
        case EventTypePatrolRoute:
        case EventTypePatrolInfo: 
        case EventTypeBirdRoute:
        case EventTypeTeamFight:
        case EventTypeUnknown28:
        case EventTypeUnknown30:
        case EventTypeUnknown31:
        case EventTypeUnknown32:
        case EventTypeUnknown33:
        case EventTypeUnknown34:
        case EventTypeUnknown35:
        case EventTypeUnknown36:
        case EventTypeUnknown37:
        case EventTypeMapOffset:
        case EventTypeSignPuddle:
            Assert(typeOffset); 
            break;
        
        case EventTypeOther: Assert(!typeOffset); break;
        
        default: Assert(false, Str("Unknown event type: %d", type));
    }
    
    if (typeOffset) {
        FSeek(start + typeOffset);
        switch (type) {
            case EventTypeTreasure: EventTreasure treasure; break;
            case EventTypeGenerator: EventGenerator generator; break;
            case EventTypeObjAct: EventObjAct objAct; break;
            case EventTypePlatoonInfo: EventPlatoonInfo platoonInfo; break;
            case EventTypePatrolRoute: EventPatrolRoute patrolRoute; break;
            case EventTypePatrolInfo: EventPatrolInfo patrolInfo; break;
            case EventTypeBirdRoute: EventBirdRoute birdRoute; break;
            case EventTypeTeamFight: EventTeamFight teamFight; break;
            case EventTypeUnknown28: EventType28 type28; break;
            case EventTypeUnknown30: EventType30 type30; break;
            case EventTypeUnknown31: EventType31 type31; break;
            case EventTypeUnknown32: EventType32 type32; break;
            case EventTypeUnknown33: EventType33 type33; break;
            case EventTypeUnknown34: EventType34 type34; break;
            case EventTypeUnknown35: EventType35 type35; break;
            case EventTypeUnknown36: EventType36 type36; break;
            case EventTypeUnknown37: EventType37 type37; break;
            case EventTypeMapOffset: EventMapOffset mapOffset; break;
            case EventTypeSignPuddle: EventSignPuddle signPuddle; break;
            default: Assert(false, Str("Unexpected event type: %d", type));
        }
    }
    
} Event <read=ReadEvent, bgcolor=cYellow>;

wstring ReadEvent(Event &e) {
    return Str("[%4d] <%s> ", e.typeIndex, EnumToString(e.type)) + e.name;    
}

