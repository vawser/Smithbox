    EventTypeUnknown30 = 30,
    EventTypeUnknown31 = 31,
    EventTypeUnknown32 = 32,
    EventTypeUnknown33 = 33,
    EventTypeUnknown34 = 34,
    EventTypeUnknown35 = 35,
    EventTypeUnknown36 = 36,
    EventTypeUnknown37 = 37,
    EventTypeOther = -1,
};

struct EventCommon;
struct EventStruct28;

struct EventTreasure;
struct EventGenerator;
struct EventObjAct;
struct EventPlatoonInfo;
struct EventPatrolRoute;
struct EventPatrolInfo;
struct EventBirdRoute;
