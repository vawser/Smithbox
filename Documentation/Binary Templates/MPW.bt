#include "Util.bt"
LittleEndian();

//------------------------------------------------

typedef struct {
    char magic[4]; Assert(magic == "mpWF");
    int version; Assert(version == 1);
    int fileSize <format=hex>;
    int panelCount;
} Header <bgcolor=cLtRed>;

// A 4 m wide, 10 m tall panel, centered on its position and standing up from it
typedef struct {
    float position[3];
    float rotationY; // Radians: 0 runs along X, pi / 2 along Z
} Panel <bgcolor=cLtGreen, optimize=false>;

//------------------------------------------------

Header header;
struct { Panel panels[header.panelCount]; } panels;
