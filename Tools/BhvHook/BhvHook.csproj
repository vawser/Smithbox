<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC6 BHV hook DLL (NativeAOT), loaded by me3 with disable_arxan. Patches four call sites in the BHV state
       machine and logs state entries, transition checks, condition results and target remaps during normal play.
       Build: dotnet publish -c Release -r win-x64. See Documentation/Claude/BHV Format.md. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>BhvHook</AssemblyName>
  </PropertyGroup>

</Project>
