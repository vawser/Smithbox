<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Unified Havok Library Plan, Phase 6.3: the Havok Editor's read/save path before (HKLib 2018/2019, HKX2) and after
       (Havok.Files) on game files, plus the field hiding and meta lookup the editor now does per SDK -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Andre\Andre.IO\Andre.IO.csproj" />
    <ProjectReference Include="..\..\src\Andre\Andre.Formats\Andre.Formats.csproj" />
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
    <ProjectReference Include="..\..\src\Havok\HKX2\Havok.HKX2.csproj" />
    <ProjectReference Include="..\..\src\Havok\HKLib\Havok.HKLib.csproj" />
    <ProjectReference Include="..\..\src\Havok\HKLib.Reflection\Havok.HKLib.Reflection.csproj" />
    <ProjectReference Include="..\..\src\Havok\HKLib.Serialization\Havok.HKLib.Serialization.csproj" />
    <ProjectReference Include="..\..\src\Havok\Havok.Files\Havok.Files.csproj" />
  </ItemGroup>

  <!-- The survey's cross-class-set graph compare -->
  <ItemGroup>
    <Compile Include="..\HavokLibSurvey\GraphCompare.cs" Link="GraphCompare.cs" />
  </ItemGroup>

  <!-- Oodle, for the KRAK compressed files of the later games -->
  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
