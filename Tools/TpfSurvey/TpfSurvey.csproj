<Project Sdk="Microsoft.NET.Sdk">

  <!-- DB_NT (Switch 2) TPF texture survey: header layout, block linear sizes, decode checks and PNG previews.
       See Documentation/Claude/DB_NT Textures.md -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The Texture Viewer's DDS decoder, for previews of the BCn textures -->
  <ItemGroup>
    <Compile Include="../../src/Smithbox.Program/Editors/Texture Viewer/Utils/DdsDecoder.cs" Link="Linked/DdsDecoder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.DirectXTex" Version="2.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
