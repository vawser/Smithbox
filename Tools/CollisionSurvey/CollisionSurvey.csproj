<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- The Collision Generator's compressed mesh builder, round-tripped against game files -->
  <ItemGroup>
    <Compile Include="..\..\src\Smithbox.Program\Editors\Havok Editor\Utilities\HavokCompressedMeshBuilder.cs" Link="Linked\HavokCompressedMeshBuilder.cs" />
    <Compile Include="..\..\src\Smithbox.Program\Editors\Havok Editor\Utilities\HavokCompressedMeshGenerator_HKX3.cs" Link="Linked\HavokCompressedMeshGenerator_HKX3.cs" />
    <Compile Include="..\..\src\Smithbox.Program\Editors\Havok Editor\Utilities\HavokShapeGenerator_Shared.cs" Link="Linked\HavokShapeGenerator_Shared.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Andre\Andre.IO\Andre.IO.csproj" />
    <ProjectReference Include="..\..\src\Andre\Andre.Formats\Andre.Formats.csproj" />
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
    <ProjectReference Include="..\..\src\Havok\HKX2\Havok.HKX2.csproj" />
    <ProjectReference Include="..\..\src\Havok\HKLib\Havok.HKLib.csproj" />
    <ProjectReference Include="..\..\src\Havok\HKLib.Serialization\Havok.HKLib.Serialization.csproj" />
  </ItemGroup>

  <!-- Oodle, for the KRAK compressed files of the later games -->
  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>


</Project>
