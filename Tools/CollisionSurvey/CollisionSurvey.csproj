<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- The Collision Generator's compressed mesh builder, round-tripped against game files. The algorithm
       (Havok.Builders) and the 2018/2019 shapes (Havok.hk2018/hk2019.Builders.CollisionShapeBuilder) come through
       Havok.Files; DS3's generator still lives in Smithbox. -->
  <ItemGroup>
    <Compile Include="..\..\src\Smithbox.Program\Editors\Havok Editor\Utilities\HavokCompressedMeshGenerator_hk2014.cs" Link="Linked\HavokCompressedMeshGenerator_hk2014.cs" />
    <!-- The Collision Editor's shape code, checked by the create mode -->
    <Compile Include="..\..\src\Smithbox.Program\Editors\Map Editor\Tools\Collision Editor\CollisionEditorShapes.cs" Link="Linked\CollisionEditorShapes.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Andre\Andre.IO\Andre.IO.csproj" />
    <ProjectReference Include="..\..\src\Andre\Andre.Formats\Andre.Formats.csproj" />
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
    <!-- Reads and writes through the unified Havok library (Phase 6.4; HKLib and HKX2 before) -->
    <ProjectReference Include="..\..\src\Havok\Havok.Files\Havok.Files.csproj" />
  </ItemGroup>

  <!-- Oodle, for the KRAK compressed files of the later games -->
  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>


</Project>
