<Project Sdk="Microsoft.NET.Sdk">

  <!-- AC6 BHV runtime probe: read-only memory scan of a running armoredcore6.exe for loaded .bhv data,
       the objects that point at it, and field changes while playing. See Documentation/Claude/BHV Format.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Andre\Andre.IO\Andre.IO.csproj" />
    <ProjectReference Include="..\..\src\Andre\Andre.Formats\Andre.Formats.csproj" />
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
