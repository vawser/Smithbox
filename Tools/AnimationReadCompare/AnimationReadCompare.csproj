<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <!-- Unified Havok Library Plan, Phase 6.1: the renderer's old animation reader (SoulsFormats HKX and the schema-less
       HavokTagfile) against the new one (Havok.Files and the Havok.Shared views), on real anibnds -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Andre\Andre.IO\Andre.IO.csproj" />
    <ProjectReference Include="..\..\src\Andre\Andre.Formats\Andre.Formats.csproj" />
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
    <ProjectReference Include="..\..\src\Havok\Havok.Files\Havok.Files.csproj" />
  </ItemGroup>

  <!-- Oodle, for the KRAK compressed files of the later games -->
  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
