<Project Sdk="Microsoft.NET.Sdk">

  <!-- Temporary (Navigation Editor Other Games Plan, Phase N1): NavSurvey's overlay and stitchedit modes, unchanged,
       built against the navigation sources from before N1 (BaseNavigation, exported from git HEAD), to diff their output
       with the N1 build's. Run from src/Smithbox.Data like NavSurvey: NavBaselineCheck overlay [args] (stitchedit until N2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotRecast.Recast" Version="2026.3.1" />
    <Compile Include="../../Claude/Tools/NavSurvey/Overlay.cs" Link="Survey/Overlay.cs" />

    <Compile Include="BaseNavigation/NavigationModel.cs" />
    <Compile Include="BaseNavigation/NavigationValidator.cs" />
    <Compile Include="BaseNavigation/NavigationReader.cs" />
    <Compile Include="BaseNavigation/NavigationOverlay.cs" />
    <Compile Include="BaseNavigation/NavigationUserEdges.cs" />
    <Compile Include="BaseNavigation/NavigationStitch.cs" />
    <Compile Include="BaseNavigation/NavigationStitchPlan.cs" />
    <Compile Include="BaseNavigation/NavigationModels.cs" />
    <Compile Include="BaseNavigation/NavigationTree.cs" />
    <Compile Include="BaseNavigation/NavigationGenerator.cs" />
    <Compile Include="BaseNavigation/NavigationBlocker.cs" />
    <Compile Include="BaseNavigation/NavigationLinkGenerator.cs" />
    <Compile Include="BaseNavigation/NavigationVertexEdit.cs" />
    <Compile Include="BaseNavigation/NavigationClearance.cs" />
    <Compile Include="BaseNavigation/NavigationGates.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BaseNavigation/NavigationTool*.cs;BaseNavigation/NavigationOverlayRenderer.cs" />
    <ProjectReference Include="..\..\src\Andre\Andre.IO\Andre.IO.csproj" />
    <ProjectReference Include="..\..\src\Andre\Andre.Formats\Andre.Formats.csproj" />
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
    <ProjectReference Include="..\..\src\Havok\Havok.Files\Havok.Files.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
