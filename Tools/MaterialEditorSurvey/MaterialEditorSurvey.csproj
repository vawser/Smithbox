<Project Sdk="Microsoft.NET.Sdk">

  <!-- Material Editor Plan, research R1-R4: which material binders each game has and which the editor picks up,
       repeated material names, MTD/MATBIN/binder round trips, and what the MATBIN Key fields are.
       See Documentation/Claude/Material Editor Plan.md. Run from src/Smithbox.Data. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The Material Editor's key rule and checks, run over vanilla data by the check mode -->
  <ItemGroup>
    <Compile Include="../../src/Smithbox.Program/Editors/Material Editor/Utils/MaterialKeys.cs" Link="Linked/MaterialKeys.cs" />
    <Compile Include="../../src/Smithbox.Program/Editors/Material Editor/Utils/MaterialChecks.cs" Link="Linked/MaterialChecks.cs" />
    <Compile Include="../../src/Smithbox.Program/Editors/Material Editor/Utils/MaterialShaderInfo.cs" Link="Linked/MaterialShaderInfo.cs" />
    <Compile Include="../../src/Smithbox.Program/Editors/Material Editor/Utils/FlverMaterialNames.cs" Link="Linked/FlverMaterialNames.cs" />
    <Compile Include="../../src/Smithbox.Program/Editors/Material Editor/Utils/MaterialQuery.cs" Link="Linked/MaterialQuery.cs" />
    <Compile Include="../../src/Smithbox.Program/Editors/Material Editor/Utils/MaterialJson.cs" Link="Linked/MaterialJson.cs" />
    <Compile Include="../../src/Smithbox.Program/Editors/Material Editor/Utils/TpfTextureNames.cs" Link="Linked/TpfTextureNames.cs" />
    <Compile Include="../../src/Smithbox.Program/Renderer/Materials/MaterialDefinition.cs" Link="Linked/MaterialDefinition.cs" />
    <Compile Include="../../src/Smithbox.Program/Renderer/Materials/MaterialBinding.cs" Link="Linked/MaterialBinding.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Andre\Andre.IO\Andre.IO.csproj" />
    <ProjectReference Include="..\..\src\Andre\Andre.Formats\Andre.Formats.csproj" />
    <ProjectReference Include="..\..\src\Andre\SoulsFormats\SoulsFormats\Andre.SoulsFormats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Smithbox.Release\Output\oo2core_*_win64.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
