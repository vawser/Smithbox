<Project Sdk="Microsoft.NET.Sdk">

    <!-- Unified Havok library, Phase 1: SDK-agnostic type model, registry + overlays, game profiles, header sniffing.
         Standalone: HKLib is not switched over to it until Phase 2 (Documentation/Claude/Unified Havok Library Plan.md). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Havok</RootNamespace>
        <Platforms>AnyCPU;x64</Platforms>
    </PropertyGroup>

    <!-- Every registry. The 2018/2019 ones (and NR's overlay) came from HKLib.Reflection, moved here in Phase 7; the
         others were built from the games' files (Tools/HavokLibSurvey, Tools/HavokClassDumpConvert). -->
    <ItemGroup>
        <Content Include="Res\*.xml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
