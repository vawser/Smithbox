<Project Sdk="Microsoft.NET.Sdk">

    <!-- Bridge from the unified tagfile engine to HKLib's hk2018/hk2019 classes, until the generated Havok.hkXXXX
         classes replace them (retired in Phase 7 of Documentation/Claude/Unified Havok Library Plan.md) -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Havok.Formats.HKLib</RootNamespace>
        <Platforms>AnyCPU;x64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Havok.Formats\Havok.Formats.csproj" />
        <ProjectReference Include="..\HKLib\Havok.HKLib.csproj" />
        <ProjectReference Include="..\HKLib.Reflection\Havok.HKLib.Reflection.csproj" />
    </ItemGroup>

</Project>
