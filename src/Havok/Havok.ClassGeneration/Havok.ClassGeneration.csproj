<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Generates an SDK class set for the unified Havok library (classes, accessors, identity type map) from a type registry.
        The 2018 sources are compiled in directly so the generator can reuse the naming and placement of the 2018 classes,
        without depending on the code it produces.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>11</LangVersion>
        <Platforms>AnyCPU;x64</Platforms>
        <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8933</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\HKLib\GlobalUsing.cs" Link="HKLib\GlobalUsing.cs" />
        <Compile Include="..\HKLib\ValueTypes\**\*.cs" Link="HKLib\ValueTypes\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\HKLib\hk2018\**\*.cs" Exclude="..\HKLib\hk2018\Autogen\UnitTest\**" Link="HKLib\hk2018\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\HKLib.Reflection\HavokType.cs" Link="HKLib.Reflection\HavokType.cs" />
        <Compile Include="..\HKLib.Reflection\hk2018\**\*.cs" Link="HKLib.Reflection\hk2018\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- loaded by the static 2018 type registry -->
        <Content Include="..\HKLib.Reflection\Res\HavokTypeRegistry20180100.xml" Link="Res\HavokTypeRegistry20180100.xml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Havok.Shared\Havok.Shared.csproj" />
    </ItemGroup>

</Project>
