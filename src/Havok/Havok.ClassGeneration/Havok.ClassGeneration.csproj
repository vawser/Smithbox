<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Generates an SDK class set for the unified Havok library (classes, accessors, identity type map) from a type registry.
        Registries load through Havok.Core. Types that also exist in Havok.hk2018 keep its naming and placement, so the
        generator references the current hk2018 build: regenerate into a scratch folder, diff, then swap Autogen, so
        Havok.hk2018 still builds while it runs. (HKLib's 2018 sources served this until Phase 7.)
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>11</LangVersion>
        <Platforms>AnyCPU;x64</Platforms>
        <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8933</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Havok.Core\Havok.Core.csproj" />
        <ProjectReference Include="..\Havok.Shared\Havok.Shared.csproj" />
        <ProjectReference Include="..\Classes\Havok.hk2018\Havok.hk2018.csproj" />
    </ItemGroup>

</Project>
