<Project Sdk="Microsoft.NET.Sdk">

    <!-- Havok 2019 classes (AC6), generated by Havok.ClassGeneration from HKLib.Reflection/Res/HavokTypeRegistry20190100.xml.
         Don't edit Autogen: move it to the .archive folder and regenerate. Hand-written members go in Manual. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Havok.hk2019</RootNamespace>
        <Platforms>AnyCPU;x64</Platforms>
        <!-- generated code: field naming and nullability follow the Havok types -->
        <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8933;CS0108;CS0109</NoWarn>
    </PropertyGroup>

    <!-- The Collision Generator's shapes: one source shared with Havok.hk2018, HK2019 selects this class set -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);HK2019</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\Shared\CollisionShapeBuilder.cs" Link="Builders\CollisionShapeBuilder.cs" />
        <!-- The Navigation tool's editable navmesh views: one source shared by every class set with navmeshes -->
        <Compile Include="..\Shared\NavMeshEdit.cs" Link="Manual\NavMeshEdit.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Havok.Core\Havok.Core.csproj" />
        <ProjectReference Include="..\..\Havok.Formats\Havok.Formats.csproj" />
        <ProjectReference Include="..\..\Havok.Shared\Havok.Shared.csproj" />
    </ItemGroup>

</Project>
