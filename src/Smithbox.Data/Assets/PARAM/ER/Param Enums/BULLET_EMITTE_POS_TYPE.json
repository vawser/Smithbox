    {
      "Key": "3",
      "Names": [
        {
          "Language": "English",
          "Text": "At Target"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "Created relative to a nearby enemy or the target; falls back to the bullet origin."
        }
      ]
    },
    {
      "Key": "4",
      "Names": [
        {
          "Language": "English",
          "Text": "Around Nearest Enemy"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "Created at a random point around the nearest enemy within Random Create Radius."
        }
      ]
    },
    {
      "Key": "5",
      "Names": [
        {
          "Language": "English",
          "Text": "Parent Bullet"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "For child bullets: created at the parent bullet instead of the hit location."
        }
      ]
    },
    {
      "Key": "6",
      "Names": [
        {
          "Language": "English",
          "Text": "Stored Placement"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
