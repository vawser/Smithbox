{
  "Key": "SP_EFFECT_PARAM_DELETE_DAMAGE_TYPE",
  "Names": [
    {
      "Language": "English",
      "Text": "Delete On Damage Criteria"
    }
  ],
  "Options": [
    {
      "Key": "0",
      "Names": [
        {
          "Language": "English",
          "Text": "Never"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "Taking damage never ends this effect."
        }
      ]
    },
    {
      "Key": "1",
      "Names": [
        {
          "Language": "English",
          "Text": "Any Damage"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The effect ends when the character takes any hit that deals damage."
        }
      ]
    },
    {
      "Key": "2",
      "Names": [
        {
          "Language": "English",
          "Text": "Physical Type Hit"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The effect ends on a damaging hit whose Physical Attribute is not None (254)."
        }
      ]
    },
    {
      "Key": "3",
      "Names": [
        {
          "Language": "English",
          "Text": "Special Attribute Hit"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The effect ends on a damaging hit whose Special Attribute is not Default (0). This includes 254 (None), so only hits with Special Attribute 0 leave it."
        }
      ]
    },
    {
      "Key": "4",
      "Names": [
        {
          "Language": "English",
          "Text": "Slash Hit"
        }
