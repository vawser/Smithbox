          "Language": "English",
          "Text": "Always"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The chained bullet spawns on every hit and on expiry."
        }
      ]
    },
    {
      "Key": "1",
      "Names": [
        {
          "Language": "English",
          "Text": "Hit Water"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The chained bullet spawns only when the hit material is water."
        }
      ]
    },
    {
      "Key": "2",
      "Names": [
        {
          "Language": "English",
          "Text": "Hit Water or Swamp"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The chained bullet spawns only when the hit material is water or any swamp (poison, rot, blood)."
        }
      ]
    },
    {
      "Key": "3",
      "Names": [
        {
          "Language": "English",
          "Text": "Always (3)"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "Same as Always."
        }
      ]
    },
    {
      "Key": "4",
      "Names": [
        {
          "Language": "English",
          "Text": "Hit Character or Expired"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The chained bullet spawns when the hit has no material (a character hit) and when the bullet expires."
        }
      ]
    },
    {
      "Key": "5",
      "Names": [
        {
          "Language": "English",
          "Text": "Hit Map or Object"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The chained bullet spawns only when the hit has a material (map or object). Not on expiry."
        }
      ]
    },
    {
      "Key": "6",
      "Names": [
        {
          "Language": "English",
          "Text": "Absorbed"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The chained bullet spawns only when this bullet was absorbed by an Absorb field (Attach Effect Type 5)."
        }
      ]
    },
