      "Language": "English",
      "Text": "Behavior Identifier"
    }
  ],
  "Options": [
    {
      "Key": "0",
      "Names": [
        {
          "Language": "English",
          "Text": "None"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "No tag."
        }
      ]
    },
    {
      "Key": "1",
      "Names": [
        {
          "Language": "English",
          "Text": "Rolling"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "HKS BEH_IDENTIFIER_ROLLING. Players and enemies play no damage reaction (enemies with the rolling-push SpEffect get a push instead). Riders and mounts ignore it."
        }
      ]
    },
    {
      "Key": "2",
      "Names": [
        {
          "Language": "English",
          "Text": "No Additive Blend"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "HKS BEH_IDENTIFIER_NO_ADD_BLEND. The hit plays no additive damage blend animation."
        }
      ]
    },
    {
      "Key": "3",
      "Names": [
        {
          "Language": "English",
          "Text": "Large Damage 2"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "Player behaviour: a large-damage hit plays W_DamageLarge2 instead of the normal large damage."
        }
      ]
    },
    {
      "Key": "4",
      "Names": [
        {
          "Language": "English",
          "Text": "Insect"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "HKS BEH_IDENTIFIER_INSECT. Enemies with SpEffect 5731 play their special damage reaction."
        }
      ]
    },
    {
      "Key": "5",
      "Names": [
        {
          "Language": "English",
          "Text": "Golem Confusion"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "HKS BEH_IDENTIFIER_GOLEM_CONFUSION. Adds confusion points to golems; past the threshold the golem is confused."
        }
      ]
    },
    {
      "Key": "6",
      "Names": [
        {
          "Language": "English",
          "Text": "Maliketh Parry"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "HKS BEH_IDENTIFIER_MARIQUES_PARRY. Enemies with SpEffect 15280/15281 play their parry events."
        }
      ]
    },
    {
      "Key": "7",
      "Names": [
        {
          "Language": "English",
          "Text": "Morgott Trauma"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "HKS BEH_IDENTIFIER_TRAUMA_MORGOTT. Trauma reaction on enemies with SpEffect 16248."
        }
      ]
    },
    {
      "Key": "8",
      "Names": [
        {
          "Language": "English",
          "Text": "Greater Demon Trauma"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "HKS BEH_IDENTIFIER_TRAUMA_GREATER_DEMON. Trauma reaction on enemies with SpEffect 10680."
        }
      ]
    },
    {
      "Key": "9",
      "Names": [
        {
          "Language": "English",
          "Text": "Chain Recover"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "Player behaviour: the damage count uses chain recovery (UseChainRecover). Used by most player attacks."
        }
      ]
    },
    {
      "Key": "10",
      "Names": [
        {
          "Language": "English",
          "Text": "Fall Safe / Huge Blow 1"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "Player behaviour: no damage reaction when falling from 10 m or more; a huge blow uses damage variant 1."
        }
      ]
    },
