      "Language": "English",
      "Text": "Follow Type"
    }
  ],
  "Options": [
    {
      "Key": "0",
      "Names": [
        {
          "Language": "English",
          "Text": "None"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The bullet moves on its own."
        }
      ]
    },
    {
      "Key": "1",
      "Names": [
        {
          "Language": "English",
          "Text": "Follow Shooter (Dummy Poly)"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The bullet moves with the shooter's emit dummy poly (or the shooter's position when there is none)."
        }
      ]
    },
    {
      "Key": "2",
      "Names": [
        {
          "Language": "English",
          "Text": "Follow Shooter Root"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The bullet moves one-to-one with the shooter's root position (feet)."
        }
      ]
    },
    {
      "Key": "3",
      "Names": [
        {
          "Language": "English",
          "Text": "Follow Target Point"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The bullet moves with the target point: the lock-on target, or the aim point ahead when not locked on. Vanilla: Death Rite Bird spears."
        }
      ]
    },
    {
      "Key": "4",
      "Names": [
        {
          "Language": "English",
          "Text": "Ground Hugging"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "No following. The bullet keeps to the ground: ground handling changes and hit positions are lifted slightly off the surface."
        }
      ]
    },
    {
      "Key": "5",
      "Names": [
        {
          "Language": "English",
          "Text": "Follow Shooter Centre"
        }
      ],
      "Descriptions": [
        {
          "Language": "English",
          "Text": "The bullet moves with the middle of the shooter's body (position plus half its height)."
        }
      ]
    }
  ]
}