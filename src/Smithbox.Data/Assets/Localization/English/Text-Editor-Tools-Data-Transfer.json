    },
    {
      "Key": "TEXT_DataTransfer_Tab_Import",
      "Text": "Import"
    },
    {
      "Key": "TEXT_DataTransfer_Import_Hint",
      "Text": "Import a JSON text export into the selected container. Text files are matched by ID and name. The import can be undone."
    },
    {
      "Key": "TEXT_DataTransfer_Header_Import_Scope",
      "Text": "Scope"
    },
    {
      "Key": "TEXT_DataTransfer_Header_Import_Scope_TT",
      "Text": "Where the import can write.\n\nContainer: every matching text file of the selected container.\nText File: the selected text file only.\nSelected Entries: the selected text file and the other text files of its entry group."
    },
    {
      "Key": "TEXT_DataTransfer_Header_Import_Type",
      "Text": "Mode"
    },
    {
      "Key": "TEXT_DataTransfer_Header_Import_Type_TT",
      "Text": "How imported entries are applied. Neither mode removes entries."
    },
    {
      "Key": "TEXT_DataTransfer_Import_Mode_Append_Desc",
      "Text": "Adds entries whose IDs are missing. Existing entries are never changed."
    },
    {
      "Key": "TEXT_DataTransfer_Import_Mode_Replace_Desc",
      "Text": "Adds missing entries and updates the text of existing ones. Nothing is removed."
    },
