    { "Key": "CUTSCENE_Properties_Move", "Text": "Move" },
    { "Key": "CUTSCENE_Properties_Move_TT", "Text": "Move this cut: drag the viewport's gizmo, or edit its position and rotation in the properties. Turn off Look Through to see the gizmo from outside." },
    { "Key": "CUTSCENE_Properties_Placement", "Text": "Placement of {0}" },
    { "Key": "CUTSCENE_Properties_Placement_Hint", "Text": "Position, then rotation in degrees. Every key of the offset.sib moves by as much." },
    { "Key": "CUTSCENE_Properties_Placement_Fields_TT", "Text": "The first key's position and rotation (degrees). Drag, or double-click to type. One undo step per edit." },
