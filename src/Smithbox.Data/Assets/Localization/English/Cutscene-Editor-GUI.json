    { "Key": "CUTSCENE_Properties_Unsaved", "Text": "Unsaved changes: File > Save writes them into the project." },

    { "Key": "CUTSCENE_Timeline_Add_Event", "Text": "Add Event" },
    { "Key": "CUTSCENE_Timeline_Add_Event_TT", "Text": "Add an event of any type at the playhead, made from one in the project's cutscenes. It goes under the selected event's timeline, or at the top if none is selected." },
    { "Key": "CUTSCENE_Timeline_Add_Under", "Text": "Under timeline {0}, at frame {1}" },
