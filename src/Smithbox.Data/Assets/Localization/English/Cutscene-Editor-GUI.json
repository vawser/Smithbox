    { "Key": "CUTSCENE_List_Map_Open_World", "Text": "An open world cutscene: pick the tile it plays on, as its files don't say." },
    { "Key": "CUTSCENE_List_Map_Unavailable", "Text": "Maps need the Map Editor enabled for this project, and the Vulkan viewport." },
