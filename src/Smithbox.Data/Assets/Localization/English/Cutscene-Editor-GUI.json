    { "Key": "CUTSCENE_Menu_Camera", "Text": "Camera" },
    { "Key": "CUTSCENE_Menu_Look_Through", "Text": "Look Through Camera" },
    { "Key": "CUTSCENE_Menu_Look_Through_TT", "Text": "Show the cut through its camera, with its field of view. Turn it off for a free camera, which starts where the cutscene camera was." },
    { "Key": "CUTSCENE_Menu_Forward_Axis", "Text": "Camera looks along" },
    { "Key": "CUTSCENE_Menu_Up_Axis", "Text": "Camera up is" },
    { "Key": "CUTSCENE_Menu_Axes_TT", "Text": "Which axes of the camera bone it looks and points up along. The files don't say: if the view looks away from the actors or is rolled, try another pair, and report the one that works." },
    { "Key": "CUTSCENE_Menu_Fov_Horizontal", "Text": "Field of View is Horizontal" },
    { "Key": "CUTSCENE_Menu_Fov_Horizontal_TT", "Text": "Read the camera's FOV track as a horizontal field of view rather than a vertical one." },
    { "Key": "CUTSCENE_Menu_Load_Models", "Text": "Load Models" },
    { "Key": "CUTSCENE_Menu_Load_Models_TT", "Text": "Load the models of the cut's characters and assets. Without them, actors are drawn as markers." },
