    { "Key": "CUTSCENE_Timeline_Duplicate", "Text": "Duplicate" },
    { "Key": "CUTSCENE_Timeline_Duplicate_TT", "Text": "Copy the event, with a new ID, into a timeline of its own beside it. It uses the same resource." },
    { "Key": "CUTSCENE_Timeline_Duplicate_New_Resource", "Text": "Duplicate as New Resource" },
    { "Key": "CUTSCENE_Timeline_Duplicate_New_Resource_TT", "Text": "Copy the event and its resource, so the copy is a thing of its own (a second subtitle, light or SFX). Not for models, cameras and animations, which need the cut's Havok data." },
    { "Key": "CUTSCENE_Timeline_Delete", "Text": "Delete" },
    { "Key": "CUTSCENE_Timeline_Delete_TT", "Text": "Take the event out of its timeline. The timeline stays, empty, so no other timeline's index changes." },

