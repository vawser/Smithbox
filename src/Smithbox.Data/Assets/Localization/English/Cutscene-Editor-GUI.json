    { "Key": "CUTSCENE_FiltersTool_Header", "Text": "Cutscene Filters" },
    { "Key": "CUTSCENE_FiltersTool_Hint", "Text": "What the cut shows in the viewport, and what it plays while it plays." },
    { "Key": "CUTSCENE_FiltersTool_Scene_Header", "Text": "Scene" },
    { "Key": "CUTSCENE_FiltersTool_Scene_Header_TT", "Text": "What is loaded into the viewport: the map behind the cut, and the actors' models." },
    { "Key": "CUTSCENE_FiltersTool_Map", "Text": "Map" },
    { "Key": "CUTSCENE_FiltersTool_Map_TT", "Text": "Draw the map the cutscene plays in behind it: its map pieces, and its assets if Map Assets is on. The map can't be edited here." },
    { "Key": "CUTSCENE_FiltersTool_Map_Assets", "Text": "Map Assets" },
    { "Key": "CUTSCENE_FiltersTool_Map_Assets_TT", "Text": "Draw the map's assets as well as its map pieces. Changing it reads the map again." },
    { "Key": "CUTSCENE_FiltersTool_Map_Characters", "Text": "Map Characters" },
    { "Key": "CUTSCENE_FiltersTool_Map_Characters_TT", "Text": "Draw the map's own characters (its enemy parts) where they stand, with their NpcParam model masks and, for c0000, their CharaInit equipment. The ones the cutscene's actors stand for are left out. Changing it reads the map again." },
    { "Key": "CUTSCENE_FiltersTool_Draw_Groups", "Text": "Use Draw Groups" },
    { "Key": "CUTSCENE_FiltersTool_Draw_Groups_TT", "Text": "Draw only the map parts the player would see: the draw groups of the player collision straight below where the cut's camera starts. Parts with no draw groups are always drawn." },
    { "Key": "CUTSCENE_FiltersTool_Groups_Off", "Text": "Draw groups off: {0} of {1} parts drawn." },
    { "Key": "CUTSCENE_FiltersTool_Groups_No_Collision", "Text": "This map has no player collision to stand on: all {0} parts are drawn." },
    { "Key": "CUTSCENE_FiltersTool_Groups_No_Hit", "Text": "No collision under the camera's start: all {0} parts are drawn." },
    { "Key": "CUTSCENE_FiltersTool_Groups_Standing", "Text": "Standing on {0} ({1} display groups): {2} of {3} parts drawn." },
    { "Key": "CUTSCENE_FiltersTool_Draw_Groups_Header", "Text": "Draw Groups" },
    { "Key": "CUTSCENE_FiltersTool_Draw_Groups_Header_TT", "Text": "Which parts of the map are drawn: those in the display groups of the collision the player stands on. That is the collision under the cut camera's start, unless another is chosen below." },
    { "Key": "CUTSCENE_FiltersTool_Groups_No_Map", "Text": "Load a map behind the cutscene to use its draw groups." },
    { "Key": "CUTSCENE_FiltersTool_Groups_Chosen", "Text": "Standing on {0} (chosen, {1} display groups): {2} of {3} parts drawn." },
    { "Key": "CUTSCENE_FiltersTool_Collision_Auto_Named", "Text": "Auto: under the camera ({0})" },
    { "Key": "CUTSCENE_FiltersTool_Collision_Auto_None", "Text": "Auto: under the camera (none found)" },
    { "Key": "CUTSCENE_FiltersTool_Collision_Auto_TT", "Text": "Take the collision straight below where the cut's camera starts." },
    { "Key": "CUTSCENE_FiltersTool_Collision_Row", "Text": "{0} ({1} groups)" },
    { "Key": "CUTSCENE_FiltersTool_Collision_Row_Under", "Text": "{0} ({1} groups, under the camera)" },
    { "Key": "CUTSCENE_FiltersTool_Collision_List_TT", "Text": "The map's player collisions. Pick one to stand the player on it for this cutscene, when the camera starts somewhere the player can't be. The choice is kept across the cutscene's cuts for the session." },
    { "Key": "CUTSCENE_FiltersTool_Models", "Text": "Actor Models" },
    { "Key": "CUTSCENE_FiltersTool_Models_TT", "Text": "Load the models of the cut's characters and assets. Without them, actors are drawn as markers. Changing it builds the cut again." },
    { "Key": "CUTSCENE_FiltersTool_Overlays_Header", "Text": "Overlays" },
    { "Key": "CUTSCENE_FiltersTool_Overlays_Header_TT", "Text": "What is drawn over the scene: the camera, markers and subtitles." },
    { "Key": "CUTSCENE_FiltersTool_Camera_Path", "Text": "Camera Path" },
    { "Key": "CUTSCENE_FiltersTool_Camera_Path_TT", "Text": "Draw the path the cut's cameras follow, and the axes of their keys." },
    { "Key": "CUTSCENE_FiltersTool_Camera", "Text": "Camera" },
    { "Key": "CUTSCENE_FiltersTool_Camera_TT", "Text": "Draw the frustum of the camera at the playhead (not while looking through it)." },
    { "Key": "CUTSCENE_FiltersTool_Markers", "Text": "Markers" },
    { "Key": "CUTSCENE_FiltersTool_Subtitles", "Text": "Subtitles" },
    { "Key": "CUTSCENE_FiltersTool_Fades", "Text": "Fades" },
    { "Key": "CUTSCENE_FiltersTool_Fades_TT", "Text": "Lays the colour of the cut's fade events (Fade In, Fade Out, Fade In/Out) over the viewport. A fade holds where it ended until the next one starts." },
    { "Key": "CUTSCENE_FiltersTool_Effects", "Text": "Effects" },
    { "Key": "CUTSCENE_FiltersTool_Effects_TT", "Text": "Draws the cut's effect events (sfxId) while they run, on the dummy poly of the actor they belong to. Which particle kinds are drawn, and how bright, follows the FX Editor's Viewport Rendering options." },
    { "Key": "CUTSCENE_FiltersTool_Effects_No_Fx", "Text": "Turn on the FX Editor for the project to show effect events." },
    { "Key": "CUTSCENE_FiltersTool_Effects_Indexing", "Text": "Reading the project's effects: {0} of {1} binders." },
    { "Key": "CUTSCENE_FiltersTool_Effects_None", "Text": "This cut has no effect events." },
    { "Key": "CUTSCENE_FiltersTool_Effects_Status", "Text": "{0} effect events: {1} running ({2} particles). {3} not in the project's effects." },
    { "Key": "CUTSCENE_FiltersTool_Playback_Header", "Text": "Playback" },
    { "Key": "CUTSCENE_FiltersTool_Playback_Header_TT", "Text": "What is played while the cut plays." },
    { "Key": "CUTSCENE_FiltersTool_Voices", "Text": "Subtitle Voices" },
    { "Key": "CUTSCENE_FiltersTool_Sounds", "Text": "Sound Events" },
    { "Key": "CUTSCENE_FiltersTool_No_Sound", "Text": "Turn on the Sound Editor for the project to play voices and sound events." },

