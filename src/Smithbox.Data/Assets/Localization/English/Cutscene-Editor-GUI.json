    { "Key": "CUTSCENE_Properties_Move", "Text": "Move" },
    { "Key": "CUTSCENE_Properties_Move_TT", "Text": "Move this cut: drag the viewport's gizmo, or edit its position and rotation in the properties. Turn off Look Through to see the gizmo from outside." },
    { "Key": "CUTSCENE_Properties_Placement", "Text": "Placement of {0}" },
    { "Key": "CUTSCENE_Properties_Placement_Hint", "Text": "Position, then rotation in degrees. Every key of the offset.sib moves by as much." },
    { "Key": "CUTSCENE_Properties_Placement_Fields_TT", "Text": "The first key's position and rotation (degrees). Drag, or double-click to type. One undo step per edit." },
    { "Key": "CUTSCENE_Properties_Placement_Done", "Text": "Done Moving" },
    { "Key": "CUTSCENE_Camera_Clip", "Text": "Camera Clip" },
    { "Key": "CUTSCENE_Camera_Clip_Summary", "Text": "{0}, {1} frames, FOV {2}° at the playhead" },
    { "Key": "CUTSCENE_Camera_Format", "Text": "Format" },
    { "Key": "CUTSCENE_Camera_Format_Auto", "Text": "Auto (spline when within tolerance)" },
    { "Key": "CUTSCENE_Camera_Format_Spline", "Text": "Spline" },
    { "Key": "CUTSCENE_Camera_Format_Interleaved", "Text": "Interleaved (uncompressed)" },
    { "Key": "CUTSCENE_Camera_Format_TT", "Text": "How the camera is written into the cut's Havok file on save. Auto writes a spline when it holds the camera within tolerance, else every frame uncompressed (fast cameras over large maps, as AC6 has)." },
    { "Key": "CUTSCENE_Camera_Written", "Text": "{0} written as {1}: {2} bytes, {3} frames per block, error {4:0.00}× tolerance" },
    { "Key": "CUTSCENE_Camera_Written_Interleaved", "Text": "{0} written as interleaved: {1} bytes" },
    { "Key": "CUTSCENE_Keys_Mode", "Text": "Keys" },
    { "Key": "CUTSCENE_Keys_Mode_Vanilla", "Text": "None (the game's camera)" },
    { "Key": "CUTSCENE_Keys_Mode_Offset", "Text": "Offset (corrections over the game's camera)" },
    { "Key": "CUTSCENE_Keys_Mode_Keyed", "Text": "Keyed (a curve through the keys)" },
    { "Key": "CUTSCENE_Keys_Mode_TT", "Text": "Offset keys add to the game's own camera, so its detail (shake, small moves) stays. Keyed keys replace it with a curve through them. Changing between the two clears the keys. Saving writes the camera into the cut's Havok file, and keeps the keys in .smithbox/Cutscenes in the project." },
    { "Key": "CUTSCENE_Keys_No_Vanilla", "Text": "The game has no copy of this cutscene, so Offset keys apply to the project's camera as it was read, which may already include an earlier bake." },
    { "Key": "CUTSCENE_Keys_Convert", "Text": "Convert to Keys (every N frames)" },
    { "Key": "CUTSCENE_Keys_Convert_TT", "Text": "Replaces the keys with the camera as it plays now, a key every N frames and one on the last frame, and changes to Keyed." },
    { "Key": "CUTSCENE_Keys_Vanilla_Hint", "Text": "This camera plays the game's own motion. Choose Offset or Keyed to edit it." },
    { "Key": "CUTSCENE_Keys_Add", "Text": "Add Key" },
    { "Key": "CUTSCENE_Keys_Add_TT", "Text": "Adds a key at the playhead with the camera as it plays there now." },
    { "Key": "CUTSCENE_Keys_From_View", "Text": "Key From View" },
    { "Key": "CUTSCENE_Keys_From_View_TT", "Text": "Adds a key at the playhead that puts the camera where the viewport is and looks where it looks, with the viewport's field of view. To move or turn a key afterwards, select it in the table and use the viewport gizmo." },
    { "Key": "CUTSCENE_Keys_From_View_Disabled_TT", "Text": "Turn off Look Through, move the viewport to the shot you want, then add the key from the view." },
    { "Key": "CUTSCENE_Keys_Delete", "Text": "Delete Key" },
    { "Key": "CUTSCENE_Keys_Count", "Text": "{0} keys" },
    { "Key": "CUTSCENE_Keys_Frame", "Text": "Frame" },
    { "Key": "CUTSCENE_Keys_Values", "Text": "Position  Rotation  FOV" },
    { "Key": "CUTSCENE_Keys_Interpolation", "Text": "To next" },
    { "Key": "CUTSCENE_Keys_Interpolation_TT", "Text": "How the camera moves from this key to the next: Smooth curves through the keys around it, Linear goes straight, Hold stays until the next key (a cut)." },
    { "Key": "CUTSCENE_Keys_Interpolation_Smooth", "Text": "Smooth" },
    { "Key": "CUTSCENE_Keys_Interpolation_Linear", "Text": "Linear" },
    { "Key": "CUTSCENE_Keys_Interpolation_Hold", "Text": "Hold" },
    { "Key": "CUTSCENE_Keys_Key", "Text": "Key at frame {0}" },
    { "Key": "CUTSCENE_Keys_Key_Offset", "Text": "Offset key at frame {0}" },
    { "Key": "CUTSCENE_Keys_Position", "Text": "Position" },
    { "Key": "CUTSCENE_Keys_Position_TT", "Text": "Where the camera is, in its cut's own space (the cut's placement moves it into the map)." },
    { "Key": "CUTSCENE_Keys_Position_Offset_TT", "Text": "Added to where the game's camera is, in its cut's own space." },
    { "Key": "CUTSCENE_Keys_Rotation", "Text": "Pitch, Yaw, Roll" },
    { "Key": "CUTSCENE_Keys_Rotation_TT", "Text": "Degrees. Pitch is above the horizon, yaw turns about the cut's up (0 looks along +Z, 90 along +X), roll tilts the view." },
    { "Key": "CUTSCENE_Keys_Rotation_Offset_TT", "Text": "Degrees, turned about the game's camera's own axes: pitch up, yaw sideways, roll about the view." },
    { "Key": "CUTSCENE_Keys_Fov", "Text": "FOV (°)" },
    { "Key": "CUTSCENE_Keys_Fov_Offset", "Text": "FOV change (°)" },
    { "Key": "CUTSCENE_File_Repaired", "Text": "{0} was written encrypted by an earlier save of the Cutscene Editor, which the game can't read. It was decrypted; save the cutscene to write it back readable." },
    { "Key": "CUTSCENE_Keys_Load_Failed", "Text": "The camera keys in {0} couldn't be read." },
