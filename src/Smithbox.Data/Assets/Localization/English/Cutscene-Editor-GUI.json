    { "Key": "CUTSCENE_Menu_Camera", "Text": "Camera" },
    { "Key": "CUTSCENE_Menu_Look_Through", "Text": "Look Through Camera" },
    { "Key": "CUTSCENE_Menu_Look_Through_TT", "Text": "Show the cut through its camera, with its field of view. Turn it off for a free camera, which starts where the cutscene camera was." },
    { "Key": "CUTSCENE_Menu_Forward_Axis", "Text": "Camera looks along" },
    { "Key": "CUTSCENE_Menu_Up_Axis", "Text": "Camera up is" },
    { "Key": "CUTSCENE_Menu_Axes_TT", "Text": "Which axes of the camera bone it looks and points up along. The files don't say: if the view looks away from the actors or is rolled, try another pair, and report the one that works." },
    { "Key": "CUTSCENE_Menu_Fov_Horizontal", "Text": "Field of View is Horizontal" },
    { "Key": "CUTSCENE_Menu_Fov_Horizontal_TT", "Text": "Read the camera's FOV track as a horizontal field of view rather than a vertical one." },
    { "Key": "CUTSCENE_Menu_Load_Models", "Text": "Load Models" },
    { "Key": "CUTSCENE_Menu_Load_Models_TT", "Text": "Load the models of the cut's characters and assets. Without them, actors are drawn as markers." },
    { "Key": "CUTSCENE_Menu_Display_Camera_Path", "Text": "Display Camera Path" },
    { "Key": "CUTSCENE_Menu_Display_Camera", "Text": "Display Camera" },
    { "Key": "CUTSCENE_Menu_Display_Markers", "Text": "Display Markers" },
    { "Key": "CUTSCENE_Menu_Display_Markers_TT", "Text": "Draw axes at the root of each animation (where the cut is placed), and where actors without a model are, such as the dNNNN locators, and actors whose model couldn't be loaded." },
    { "Key": "CUTSCENE_Menu_Display_Subtitles", "Text": "Show Subtitles" },
    { "Key": "CUTSCENE_Menu_Display_Subtitles_TT", "Text": "Shows the text of the subtitle events covering the playhead at the bottom of the viewport, from their TalkParam (needs the Param and Text Editors)." },
    { "Key": "CUTSCENE_Menu_Play_Voices", "Text": "Play Subtitle Voices" },
    { "Key": "CUTSCENE_Menu_Play_Voices_TT", "Text": "While the cut plays, plays the voice of each subtitle's TalkParam (a (v) sound) from when its event starts until it ends (needs the Sound Editor)." },
    { "Key": "CUTSCENE_Menu_Play_Sounds", "Text": "Play Sound Events" },
    { "Key": "CUTSCENE_Menu_Play_Sounds_TT", "Text": "While the cut plays, plays each sound event (seId, of the category its seType gives) as the playhead passes its start, to the end of the sound. Pausing or changing cut stops them (needs the Sound Editor)." },
    { "Key": "CUTSCENE_Menu_Diagnostics", "Text": "Log Each Cut" },
    { "Key": "CUTSCENE_Menu_Diagnostics_TT", "Text": "Write what each cut is built from to the log when it is shown: its placement, cameras (with their first frame's axes) and actors." },
    { "Key": "CUTSCENE_Menu_Log_Cut", "Text": "Log This Cut" },
    { "Key": "CUTSCENE_Menu_Log_Cut_TT", "Text": "Write what the cut being shown is built from to the log." },

