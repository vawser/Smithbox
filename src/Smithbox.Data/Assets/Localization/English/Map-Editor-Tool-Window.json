    },
    {
      "Key": "MAP_SelectionGroups_Contents_Empty",
      "Text": "This group holds no map objects."
    },
    {
      "Key": "MAP_SelectionGroups_Groups_Header",
      "Text": "Groups"
    },
    {
      "Key": "MAP_SelectionGroups_Groups_Header_TT",
      "Text": "The selection groups of the active map.\nClick: select the group. Double-click: select and frame its contents. Shift+Click: add its contents to the current selection."
