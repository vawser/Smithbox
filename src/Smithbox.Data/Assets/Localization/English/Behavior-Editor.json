    { "Key": "BHV_FileList_Header", "Text": "Behavior Files" },
    { "Key": "BHV_FileList_Header_TT", "Text": "Each character's behbnd and its .bhv state machines: basenormal.bhv (body), weapon.bhv and wNNN.bhv (one per weapon). In missions the player AC uses c0200." },
    { "Key": "BHV_FileList_No_Binders", "Text": "No behbnds with .bhv files were found." },
    { "Key": "BHV_FileList_Binder_TT", "Text": "{0}\n{1} .bhv files, {2} other entries (kept unchanged when saving)." },
    { "Key": "BHV_FileList_File_Info", "Text": "v{0} {1}, {2} states" },
    { "Key": "BHV_FileList_Old_Version_TT", "Text": "Version {0}: the file reads and saves exactly, but its fields don't match the enum tables, so few fields are named." },
    { "Key": "BHV_FileList_Unreadable_TT", "Text": "This file failed to read. It is kept unchanged when the behbnd is saved." },

    { "Key": "BHV_Kind_Weapon", "Text": "weapon" },
    { "Key": "BHV_Kind_Base", "Text": "base" },
    { "Key": "BHV_Kind_Empty", "Text": "empty" },
    { "Key": "BHV_Kind_Unknown", "Text": "unknown" },

    { "Key": "BHV_StateList_Header", "Text": "States" },
    { "Key": "BHV_StateList_Header_TT", "Text": "The file's states. Animation is the animation record the state plays (body +0x00) and its TAE animation ID. Out and In count the transitions leaving and entering the state." },
    { "Key": "BHV_StateList_Filter_TT", "Text": "Matches the index, the ID, \"kind N\", or the TAE animation ID." },
    { "Key": "BHV_StateList_No_Incoming_TT", "Text": "No transition in this file leads here. That is normal: game code enters some states directly (firing, animation end)." },

    { "Key": "BHV_TransitionView_Header", "Text": "Transitions" },
    { "Key": "BHV_TransitionView_Header_TT", "Text": "The selected state's transitions and their conditions. Double-click a transition to go to its target state." },
    { "Key": "BHV_TransitionView_Outgoing", "Text": "Outgoing ({0})" },
    { "Key": "BHV_TransitionView_Outgoing_TT", "Text": "The game tries these last to first, skips any that leads back to the current state, and takes the first whose conditions all pass. Conditions are checked in order." },
    { "Key": "BHV_TransitionView_Incoming", "Text": "Incoming ({0})" },
    { "Key": "BHV_TransitionView_Incoming_TT", "Text": "The transitions in other states that lead here. Click one to go to its state." },
    { "Key": "BHV_TransitionView_No_Outgoing", "Text": "No transitions: game code moves on from this state." },
    { "Key": "BHV_TransitionView_Transition", "Text": "#{0} → {1}, {2} conditions" },
    { "Key": "BHV_TransitionView_Matrix", "Text": "matrix {0}" },
    { "Key": "BHV_TransitionView_Transition_TT", "Text": "Click to show the transition's params. Double-click to go to the target state." },
    { "Key": "BHV_TransitionView_Self_TT", "Text": "This transition leads back to the same state, so the game skips it." },
    { "Key": "BHV_TransitionView_Jump_TT", "Text": "Go to this state." },
    { "Key": "BHV_TransitionView_Condition", "Text": "#{0} type {1} ({2} bytes)" },
    { "Key": "BHV_TransitionView_Optional", "Text": "[may fail]" },

    { "Key": "BHV_AnimationList_Header", "Text": "Animations" },
    { "Key": "BHV_AnimationList_Header_TT", "Text": "The file's animation records. States refer to them by index; each starts with a TAE animation ID. Used By counts the state body slots that play the record." },

    { "Key": "BHV_StructureList_Header", "Text": "Structures" },
    { "Key": "BHV_StructureList_Header_TT", "Text": "The file header and the record lists that are not decoded yet, shown as raw bytes." },
    { "Key": "BHV_StructureList_File", "Text": "File header and preamble" },
    { "Key": "BHV_StructureList_File_TT", "Text": "Show the file's version, counts and preamble. The preamble holds state indices the game reads directly." },
    { "Key": "BHV_StructureList_Struct_C", "Text": "Struct C ({0}, 0x{1:X} bytes each)" },
