    { "Key": "BHV_Properties_Header_TT", "Text": "The selected record. Known fields are named; the rest are raw bytes. Read-only for now." },
    { "Key": "BHV_Properties_Blob_TT", "Text": "Known fields come from game file surveys and the game's code. Uncoloured bytes are not decoded yet." },
