    { "Key": "BHV_Properties_File_Unk02", "Text": "Unk02" },
    { "Key": "BHV_Properties_ID_TT", "Text": "Must stay unique within the file. Changing an ID does not update anything that finds the state by ID (unknown which fields do)." },
    { "Key": "BHV_Properties_State_Kind_TT", "Text": "Unknown meaning; together with body fields it decides the layout of the state data." },
    { "Key": "BHV_Properties_Condition_Type_TT", "Text": "The condition data is read by type. Changing the type keeps the data bytes, which the new type may read differently." },

    { "Key": "BHV_Edit_Out_Of_Range", "Text": "Behavior Editor: {0} is outside {1} to {2}; edit not applied." },
    { "Key": "BHV_Edit_Duplicate_State_ID", "Text": "Behavior Editor: another state already has ID {0}; edit not applied." },
    { "Key": "BHV_Edit_Hex_Invalid", "Text": "Behavior Editor: \"{0}\" is not a whole number of hex bytes; edit not applied." },
    { "Key": "BHV_Edit_Enum_Unnamed", "Text": "{0}: (not in enum)" },

    { "Key": "BHV_Hex_Click_To_Edit", "Text": "Click a byte to edit at it." },
    { "Key": "BHV_Hex_Offset", "Text": "Offset" },
    { "Key": "BHV_Hex_Bytes", "Text": "Bytes" },
    { "Key": "BHV_Hex_Bytes_TT", "Text": "Up to 16 bytes from the cursor. Typed bytes overwrite from the cursor on; the record never changes length, so bytes past its end are dropped." },

    { "Key": "BHV_Edit_Add_State", "Text": "Add State" },
    { "Key": "BHV_Edit_Add_State_TT", "Text": "Append an empty state with the next free ID. It plays no animation and has no transitions; nothing enters it until a transition or a preamble slot points at it." },
    { "Key": "BHV_Edit_Duplicate_State", "Text": "Duplicate State" },
    { "Key": "BHV_Edit_Duplicate_State_TT", "Text": "Append a copy with the next free ID. Its transitions lead where the original's do; nothing leads into the copy yet." },
    { "Key": "BHV_Edit_Delete_State", "Text": "Delete State..." },
    { "Key": "BHV_Edit_Add_Animation", "Text": "Add Animation" },
    { "Key": "BHV_Edit_Add_Animation_TT", "Text": "Append an animation record with TAE ID -1 (none)." },
    { "Key": "BHV_Edit_Duplicate_Animation", "Text": "Duplicate Animation" },
    { "Key": "BHV_Edit_Delete_Animation", "Text": "Delete Animation..." },
    { "Key": "BHV_Edit_Add_Transition", "Text": "Add Transition" },
    { "Key": "BHV_Edit_Add_Transition_TT", "Text": "Append a transition to the state itself, with no conditions. The game skips a transition to the current state, so it does nothing until you change its target." },
    { "Key": "BHV_Edit_Duplicate_Transition", "Text": "Duplicate Transition" },
    { "Key": "BHV_Edit_Delete_Transition", "Text": "Delete Transition" },
    { "Key": "BHV_Edit_Try_Sooner", "Text": "Try Sooner" },
    { "Key": "BHV_Edit_Try_Later", "Text": "Try Later" },
    { "Key": "BHV_Edit_Try_Order_TT", "Text": "The game tries transitions from the last in the file to the first and takes the first one whose conditions pass." },
    { "Key": "BHV_Edit_Add_Condition", "Text": "Add Condition" },
    { "Key": "BHV_Edit_Add_Condition_TT", "Text": "Append a type 0 condition with no data, marked optional (Unk02 = 1) so it can't fail the transition. Set its type and data before relying on it." },
    { "Key": "BHV_Edit_Duplicate_Condition", "Text": "Duplicate Condition" },
    { "Key": "BHV_Edit_Delete_Condition", "Text": "Delete Condition" },
    { "Key": "BHV_Edit_Run_Sooner", "Text": "Run Sooner" },
    { "Key": "BHV_Edit_Run_Later", "Text": "Run Later" },

    { "Key": "BHV_Delete_Title", "Text": "Delete" },
    { "Key": "BHV_Delete_Confirm", "Text": "Delete" },
    { "Key": "BHV_Delete_Cancel", "Text": "Cancel" },
    { "Key": "BHV_Delete_State_Message", "Text": "Delete {0}?\n\n- {1} transitions into it will be removed.\n- {2} preamble slots that point at it will be set to -1 (none). Whether the game accepts -1 there is unverified.\n- The {3} states after it move down one index; every known reference to them is renumbered." },
    { "Key": "BHV_Delete_Animation_Message", "Text": "Delete {0}?\n\n- {1} state body slots that play it will be set to -1 (none).\n- The {2} records after it move down one index; every known reference to them is renumbered." },
    { "Key": "BHV_Delete_Unknown_Refs", "Text": "Only known index fields are renumbered. An index inside undecoded data would now point at a different record. Undo restores everything." },
    { "Key": "BHV_Delete_State_Log", "Text": "Behavior Editor: deleted state {0} in {1}; removed {2} transitions into it, set {3} preamble slots to -1." },

    { "Key": "BHV_Properties_Length", "Text": "Length" },
    { "Key": "BHV_Properties_Length_TT", "Text": "Resize this data. The start is kept and new bytes are 0. The file stores no length for it, so any size saves, but what the game reads from it is unknown." },

    { "Key": "BHV_Window_Graph", "Text": "Graph" },
    { "Key": "BHV_Graph_Header", "Text": "Graph" },
    { "Key": "BHV_Graph_Header_TT", "Text": "States as nodes, transitions as links. The selected state lists each transition in the order the game tries them (the last in the file first); other states show one pin for all their transitions (hover it for the list). Click to select; drag a transition pin onto a node to retarget it, or a + or compact pin to add a transition. Grey title: no transition leads in (entered by code)." },
    { "Key": "BHV_Graph_Focus_All_Too_Big", "Text": "Only for files with up to {0} states; use steps around the selection." },
    { "Key": "BHV_Graph_Hidden", "Text": "{0} states not shown" },
    { "Key": "BHV_Graph_Hidden_TT", "Text": "The graph draws at most {0} states: the selected one, then the nearest. Select another state to move the view." },
    { "Key": "BHV_Graph_Hidden_Links", "Text": "{0} links not shown" },
    { "Key": "BHV_Graph_Hidden_Links_TT", "Text": "The graph draws at most {0} links between other states; links into the selected state and nearest it are kept." },
    { "Key": "BHV_Graph_Pin_Compact", "Text": "{0} transitions" },
    { "Key": "BHV_Graph_Compact_TT", "Text": "{0}, transitions in the order the game tries them:" },
    { "Key": "BHV_Graph_More", "Text": "... {0} more" },
    { "Key": "BHV_Graph_Pair_TT", "Text": "Click to select the first of these the game tries." },
    { "Key": "BHV_Graph_Select_State", "Text": "Select a state to show the states around it, or set Focus to All." },
    { "Key": "BHV_Graph_Focus", "Text": "Focus" },
    { "Key": "BHV_Graph_Focus_All", "Text": "All ({0} states)" },
    { "Key": "BHV_Graph_Focus_Steps", "Text": "{0} step(s) around selection" },
    { "Key": "BHV_Graph_Focus_TT", "Text": "Steps: the selected state, the states it leads to on the right and the states leading into it on the left. All: every state, in layers from the states entered by code." },
    { "Key": "BHV_Graph_Frame", "Text": "Frame" },
    { "Key": "BHV_Graph_Frame_TT", "Text": "Pan to the selected state." },
    { "Key": "BHV_Graph_Shown", "Text": "{0} shown" },
    { "Key": "BHV_Graph_Shown_TT", "Text": "Last draw: {0} vertices (aims to stay under {1}; ImGui's limit is 65535). A denser graph shows fewer states and links." },
    { "Key": "BHV_Graph_Node_Title", "Text": "{0}  ·  ID {1}" },
