    { "Key": "BHV_View_Toggle_Hex", "Text": "Hex View" },
    { "Key": "BHV_View_Toggle_Hex_TT", "Text": "Show each record's raw bytes below its known fields. Known fields are coloured; hover a byte to see which field it belongs to." },
    { "Key": "BHV_View_Toggle_Game_Order", "Text": "Transitions in Game Order" },
    { "Key": "BHV_View_Toggle_Game_Order_TT", "Text": "List a state's transitions in the order the game tries them: last to first. The first one whose conditions pass is taken." },

    { "Key": "BHV_Data_Setup_Primary_Bank_PASS", "Text": "Behavior Editor: loaded {0} behbnds." },
    { "Key": "BHV_Data_Setup_Primary_Bank_FAIL", "Text": "Behavior Editor: failed to load the behbnds." },
