    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Animation",
      "Text": "Enable Material Animation"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Animation_TT",
      "Text": "If enabled, materials that animate over time will play in the viewport. If disabled, they hold their current frame."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Wind_Strength",
      "Text": "Wind Strength"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Wind_Strength_TT",
      "Text": "How strongly vegetation moves in the viewport. The game's own wind varies by place, so this is an approximation of it."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Wind_Direction",
      "Text": "Wind Direction"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Wind_Direction_TT",
      "Text": "The direction vegetation is blown in, in degrees."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Wind",
      "Text": "Wind"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Wind_TT",
      "Text": "Vegetation moves in the wind."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Vertex_Animation",
      "Text": "Vertex Animation"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Vertex_Animation_TT",
      "Text": "Flags, cloth and creatures with baked vertex animations play them."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Sway",
      "Text": "Sway"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Sway_TT",
      "Text": "Hanging objects and leaves sway back and forth."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Birds",
      "Text": "Birds"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Birds_TT",
      "Text": "Flocks of birds flap and fly around their paths."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Layer_Blending",
      "Text": "Layer Blending"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Layer_Blending_TT",
      "Text": "Materials blend their texture layers. If disabled, only the first layer is shown."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Overlays",
      "Text": "Overlay Textures"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Overlays_TT",
      "Text": "Materials apply their detail albedo and overlay normal textures."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Magma",
      "Text": "Magma"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Magma_TT",
      "Text": "Magma materials give off their flowing glow."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Emissive",
      "Text": "Emissive Textures"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Emissive_TT",
      "Text": "Materials give off light from their emissive textures."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_UV_Scroll",
      "Text": "UV Scrolling"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_UV_Scroll_TT",
      "Text": "Textures that scroll keep moving."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Unlit",
      "Text": "Sky, Clouds and Flames"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Unlit_TT",
      "Text": "Sky, clouds and flames are drawn unlit. This stands in for the game's shaders, which rely on its scene."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Water",
      "Text": "Water"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Water_TT",
      "Text": "Water gets moving ripples and a smooth surface. This stands in for the game's shaders, which rely on its scene."
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Fur",
      "Text": "Fur"
    },
    {
      "Key": "VIEWPORT_Menubar_Setting_Material_Fur_TT",
      "Text": "Fur is cut out into strands instead of being drawn as solid cards."
    },
    {
      "Key": "VIEWPORT_Menubar_Header_Scene_Lighting",
      "Text": "Scene Lighting"
    },
    {
      "Key": "VIEWPORT_Menubar_Header_Parts",
      "Text": "Parts"
    },
    {
      "Key": "VIEWPORT_Menubar_Header_Environment_Map",
      "Text": "Environment Map"
    },
    {
      "Key": "VIEWPORT_Menubar_Action_Default",
      "Text": "Default"
    },
    {
      "Key": "VIEWPORT_Menubar_Header_Global_Illumination",
      "Text": "Global Illumination"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Enable",
      "Text": "Light with Irradiance Volumes"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Enable_TT",
      "Text": "Light models inside environment boxes with the map's baked irradiance volumes, instead of the environment map. Outside every box, models keep the environment map's light."
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Auto_Exposure",
      "Text": "Auto Exposure"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Auto_Exposure_TT",
      "Text": "The volumes' light is in the game's own units. Auto exposure scales it so the volumes' average matches the viewport's default ambient light. Current exposure: {0:F1}"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Intensity",
      "Text": "Intensity"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Intensity_TT",
      "Text": "Multiplies the volumes' light. With Auto Exposure off this is the exposure itself; around 25 matches typical maps."
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Bake",
      "Text": "Bake"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Bake_TT",
      "Text": "The bake of the irradiance volumes to light the maps with, the NN of the map's envmap_NN files. Bakes are probably times of day; most Nightreign maps only have bake 0. A change applies the next time a map is loaded."
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Bake_Blend",
      "Text": "Blend Bakes"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Bake_Blend_TT",
      "Text": "Blend the volumes' light towards a second bake, as the game does between times of day. The second bake's textures load with the map, so switching this on or changing the bake applies the next time a map is loaded."
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Blend_Bake",
      "Text": "Blend Towards Bake"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Blend_Bake_TT",
      "Text": "The bake to blend towards. Volumes that don't have it keep the first bake's light."
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Blend_Ratio",
      "Text": "Blend Ratio"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Blend_Ratio_TT",
      "Text": "How far towards the second bake: 0 is the first bake, 1 the second. Applies at once."
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Normalize_Reflections",
      "Text": "Normalize Reflections"
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Normalize_Reflections_TT",
      "Text": "Scale the environment map's reflections by how bright the volumes' light is at each point compared with the volume's average, as the game does, so reflections darken in shadow and brighten in lit areas."
    },
    {
      "Key": "VIEWPORT_Menubar_Header_Map_Lighting",
      "Text": "Map Lighting"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Enable",
      "Text": "Light with the Map's GPARAMs"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Enable_TT",
      "Text": "Take the sun's direction, color and intensity, the hemisphere ambient light, and the exposure from the map's GPARAMs, as the game does. The irradiance volumes then take the same exposure instead of their auto exposure, and the hemisphere replaces the grey environment map for ambient light and reflections. With several maps loaded, the first by name with its own GPARAM lights them all."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Exposure_Scale",
      "Text": "Exposure Scale"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Exposure_Scale_TT",
      "Text": "Multiplies the GPARAM's exposure. Most maps switch on the game's auto exposure, which adjusts the exposure to what is on screen; Smithbox uses the GPARAM's value as it is, so some maps may look too bright or too dark."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Hemi_Inside_Volumes",
      "Text": "Add the Hemisphere Inside Volumes"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Hemi_Inside_Volumes_TT",
      "Text": "The GPARAM's hemisphere light (sky color from above, ground color from below) lights what the irradiance volumes don't cover, and the reflections. With this on it also adds to the volumes' light, which matches the game."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Model_Lights",
      "Text": "Light Characters with the Model Set"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Model_Lights_TT",
      "Text": "Light characters (c####) with the GPARAM LightSet's model set (ID {0}) instead of the scene's: its own sun, the fill lights (Light 1, which can turn with the camera, and the local lights) and its hemisphere. Not yet compared with the game, so it is off by default."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Background",
      "Text": "Use the GPARAM's Background Color"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Background_TT",
      "Text": "Fill the viewport's background with the BG color of the map's GPARAM (Setting Info), at the GPARAM's exposure, instead of the background color of the settings."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Active",
      "Text": "Lit from {0}, exposure {1:0.###}"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_None",
      "Text": "No loaded map has its own GPARAM, so the viewport's own sun is used."
    },
    {
      "Key": "VIEWPORT_Menubar_Scene_Sun_From_Map",
      "Text": "The sun comes from the map's GPARAMs (Render > Map Lighting)."
    },
    {
      "Key": "VIEWPORT_Menubar_GI_Auto_Exposure_Map_TT",
      "Text": "Not used while the map's GPARAMs light the viewport: the volumes take the GPARAM's exposure, as the sun does."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_File",
      "Text": "GPARAM"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_File_TT",
      "Text": "The GPARAM each value is looked for in first. Values it doesn't have come from mapbase, then default."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_File_Own",
      "Text": "Each map's own (mAA_BB_0000)"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Hours",
      "Text": "Time of Day"
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Hours_TT",
      "Text": "The time on the GPARAMs' TimeOfDay scale. Elden Ring keys its lighting at 0, 4, 8, 12, 15, 21 and 22.5, where 0 is morning, 12 evening and 15 night."
    },
    {
      "Key": "VIEWPORT_Menubar_Map_Lighting_Map",
