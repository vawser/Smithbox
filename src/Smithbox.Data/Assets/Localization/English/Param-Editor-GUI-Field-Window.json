    { "Key": "PARAM_Notice_Offline_Lottery_Input", "Text": "The game doesn't read this param. It is an input of the map pattern lottery FromSoftware ran before release, whose results ship as LotResultSmallBaseAndSpot, LotResultMapPatternFlag and LotResultPlayArea. Edit those to change the map patterns." },
    { "Key": "PARAM_Notice_Offline_Lottery_Partial", "Text": "Many fields of this param are inputs of the map pattern lottery FromSoftware ran before release, and the game doesn't read them (their descriptions say which). Changing them has no effect unless the LotResult params are changed to match." },
    { "Key": "PARAM_FieldWindow_Section_TT", "Text": "Double-click to show or hide this section." },
    { "Key": "PARAM_RandomAppear_Header", "Text": "Random Appear Slots" },
    { "Key": "PARAM_RandomAppear_Header_TT", "Text": "Which of the 100 random slots this row has set, the row that holds the other slots, and the map objects that use it." },
    { "Key": "PARAM_RandomAppear_Count", "Text": "{0} of {1} slots set: map objects on this row are placed in {2}% of sessions." },
    { "Key": "PARAM_RandomAppear_Count_TT", "Text": "Each session draws one slot from 0 to 99. A map object whose Random Appear Param ID is this row is placed only if the drawn slot is set here. Map objects on the same row always appear together." },
    { "Key": "PARAM_RandomAppear_Slot_TT", "Text": "Slot {0}" },
    { "Key": "PARAM_RandomAppear_Edit_Slot", "Text": "Edit random appear slot {0}" },
    { "Key": "PARAM_RandomAppear_All", "Text": "All" },
    { "Key": "PARAM_RandomAppear_All_TT", "Text": "Set every slot: placed in every session." },
    { "Key": "PARAM_RandomAppear_None", "Text": "None" },
    { "Key": "PARAM_RandomAppear_None_TT", "Text": "Clear every slot: never placed." },
    { "Key": "PARAM_RandomAppear_Invert", "Text": "Invert" },
    { "Key": "PARAM_RandomAppear_Invert_TT", "Text": "Swap set and clear slots, so this row places in exactly the sessions it didn't." },
    { "Key": "PARAM_RandomAppear_Duplicate_ID", "Text": "{0} rows have ID {1}. The game uses the first of them." },
    { "Key": "PARAM_RandomAppear_Complement", "Text": "Other half:" },
    { "Key": "PARAM_RandomAppear_Complement_TT", "Text": "This row has exactly the slots this one doesn't. Of two map objects on these rows, exactly one appears in each session. Click to go to it." },
    { "Key": "PARAM_RandomAppear_No_Complement", "Text": "No row has exactly the other slots." },
    { "Key": "PARAM_RandomAppear_Complement_ID", "Text": "Row ID" },
    { "Key": "PARAM_RandomAppear_Complement_ID_TT", "Text": "The ID of the row Make Complement Row creates. Retail pairs use neighbouring IDs, such as 100 and 101." },
    { "Key": "PARAM_RandomAppear_Make_Complement", "Text": "Make Complement Row" },
    { "Key": "PARAM_RandomAppear_Make_Complement_TT", "Text": "Add a row with exactly the slots this one doesn't, so two map objects on the two rows never appear together and one of them always does." },
    { "Key": "PARAM_RandomAppear_Make_Complement_Taken_TT", "Text": "A row with ID {0} already exists. Pick a free ID." },
    { "Key": "PARAM_RandomAppear_Complement_Name", "Text": "Other half of {0}" },
    { "Key": "PARAM_RandomAppear_Used_By", "Text": "Used by:" },
    { "Key": "PARAM_RandomAppear_Used_By_TT", "Text": "The map objects whose Random Appear Param ID is this row, in every map of the project. Loaded maps are read as they are in the Map Editor, the rest from the project's files." },
    { "Key": "PARAM_RandomAppear_Scan", "Text": "Scan Maps" },
    { "Key": "PARAM_RandomAppear_Rescan", "Text": "Rescan" },
    { "Key": "PARAM_RandomAppear_Scan_TT", "Text": "Read every map of the project to find which map objects use which rows. The result isn't updated as you edit maps: rescan after changing them." },
    { "Key": "PARAM_RandomAppear_Scanning", "Text": "Scanning maps ({0} of {1})..." },
    { "Key": "PARAM_RandomAppear_Scanned_At", "Text": "(scanned at {0})" },
    { "Key": "PARAM_RandomAppear_Unused", "Text": "No map object uses this row." },
    { "Key": "PARAM_RandomAppear_User_TT", "Text": "{0}. Click to show it in the Map Editor." }
