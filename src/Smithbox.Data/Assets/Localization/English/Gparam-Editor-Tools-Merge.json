{
  "Entries": [
    { "Key": "GPARAM_Merge_Header", "Text": "Merge" },
    { "Key": "GPARAM_Merge_From_File_Action", "Text": "Merge from File..." },
    { "Key": "GPARAM_Merge_From_File_Action_TT", "Text": "Merge a Data Transfer export (.json) or a GPARAM file into this project without losing your changes. Opens the Merge tool with the file and analyses it; nothing changes until you apply." },
    { "Key": "GPARAM_Merge_Hint", "Text": "Bring another mod's GPARAM changes into this project without losing yours. Each file is compared with the game's copy: what only they changed is taken, what only you changed is kept, and where both of you changed the same thing you choose. Applying is one undo step." },

    { "Key": "GPARAM_Merge_Source_Header", "Text": "Merge From" },
    { "Key": "GPARAM_Merge_Source_Header_TT", "Text": "Where the other side of the merge comes from." },
    { "Key": "GPARAM_Merge_Source_Project", "Text": "Project" },
    { "Key": "GPARAM_Merge_Source_Project_TT", "Text": "Another Smithbox project for the same game. Only the GPARAMs in its own folder are read." },
    { "Key": "GPARAM_Merge_Source_Folder", "Text": "Mod Folder" },
    { "Key": "GPARAM_Merge_Source_Folder_TT", "Text": "A mod's folder. Its root, its param folder or its drawparam folder all work." },
    { "Key": "GPARAM_Merge_Source_File", "Text": "File" },
    { "Key": "GPARAM_Merge_Source_File_TT", "Text": "One .gparam, .gparambnd or .fltparam file, matched to this project's file of the same name." },
    { "Key": "GPARAM_Merge_Source_Transfer", "Text": "Export" },
    { "Key": "GPARAM_Merge_Source_Transfer_TT", "Text": "A Data Transfer export (.json). A whole GPARAM goes into the file it came from; groups, fields or values go where they came from, or into the selection. An export of part of a file never removes anything." },
    { "Key": "GPARAM_Merge_Browse_Folder", "Text": "Browse Folder" },
    { "Key": "GPARAM_Merge_Browse_Folder_TT", "Text": "Pick the mod folder to merge from." },
    { "Key": "GPARAM_Merge_Browse_File", "Text": "Browse File" },
    { "Key": "GPARAM_Merge_Browse_File_TT", "Text": "Pick the file to merge from." },
    { "Key": "GPARAM_Merge_Browse_Transfer", "Text": "Browse Export" },
    { "Key": "GPARAM_Merge_Browse_Transfer_TT", "Text": "Pick the Data Transfer export to merge from." },
    { "Key": "GPARAM_Merge_No_Path", "Text": "Nothing picked." },
    { "Key": "GPARAM_Merge_No_Projects", "Text": "There are no other projects for this game." },

    { "Key": "GPARAM_Merge_Options_Header", "Text": "Options" },
    { "Key": "GPARAM_Merge_Options_Header_TT", "Text": "How the review starts. Changing an option clears the current analysis." },
    { "Key": "GPARAM_Merge_Conflict_Label", "Text": "Where both changed the same thing:" },
    { "Key": "GPARAM_Merge_Conflict_Label_TT", "Text": "The starting choice for each conflict. You can change any of them in the review." },
    { "Key": "GPARAM_Merge_Conflict_Keep_Mine", "Text": "Keep Mine" },
    { "Key": "GPARAM_Merge_Conflict_Keep_Mine_TT", "Text": "Conflicts start as your version." },
    { "Key": "GPARAM_Merge_Conflict_Take_Theirs", "Text": "Take Theirs" },
    { "Key": "GPARAM_Merge_Conflict_Take_Theirs_TT", "Text": "Conflicts start as their version." },
    { "Key": "GPARAM_Merge_Conflict_Ask_Each", "Text": "Ask Each" },
    { "Key": "GPARAM_Merge_Conflict_Ask_Each_TT", "Text": "Conflicts start unresolved. Apply stays off until every one is chosen." },
    { "Key": "GPARAM_Merge_Include_Removals", "Text": "Tick Removed by Them" },
    { "Key": "GPARAM_Merge_Include_Removals_TT", "Text": "Entries of the game's file that they deleted start ticked, so applying deletes them here too. Entries you changed are never ticked." },

    { "Key": "GPARAM_Merge_Actions_Header", "Text": "Actions" },
    { "Key": "GPARAM_Merge_Analyse", "Text": "Analyse" },
    { "Key": "GPARAM_Merge_Analyse_TT", "Text": "Compare the source with this project. Nothing is changed until you apply." },
    { "Key": "GPARAM_Merge_Apply", "Text": "Apply" },
    { "Key": "GPARAM_Merge_Apply_TT", "Text": "Apply the ticked changes to the ticked files, as one undo step. Files that aren't open are opened." },
    { "Key": "GPARAM_Merge_Clear", "Text": "Clear" },
    { "Key": "GPARAM_Merge_Clear_TT", "Text": "Drop the current analysis." },
    { "Key": "GPARAM_Merge_Analysing", "Text": "Analysing..." },
    { "Key": "GPARAM_Merge_Unresolved_Hint", "Text": "{0} conflicts still need a choice." },

    { "Key": "GPARAM_Merge_Report_Applied", "Text": "Applied {0} changes to {1} files." },
    { "Key": "GPARAM_Merge_Report_Added", "Text": "Added {0} files to the project." },
    { "Key": "GPARAM_Merge_Report_Stale", "Text": "{0} changes were left alone because the entry was edited after the analysis." },
    { "Key": "GPARAM_Merge_Report_Problems", "Text": "{0} problems (hover for the list)." },

    { "Key": "GPARAM_Merge_Plan_Header", "Text": "Review" },
    { "Key": "GPARAM_Merge_Plan_Header_TT", "Text": "What applying will do, per file and per entry." },
    { "Key": "GPARAM_Merge_Plan_Summary", "Text": "From {0}: {1} files with changes ({2} added, {3} changed, {4} conflicts, {5} removed by them); {6} files the same." },
    { "Key": "GPARAM_Merge_Plan_Empty", "Text": "Nothing to merge." },
    { "Key": "GPARAM_Merge_Problems_Header", "Text": "Problems and warnings ({0})" },
    { "Key": "GPARAM_Merge_Problems_Header_TT", "Text": "Files that couldn't be read or matched, and anything else worth knowing. Also in the log." },
    { "Key": "GPARAM_Merge_More", "Text": "... and {0} more" },
    { "Key": "GPARAM_Merge_Unmatched", "Text": "{0} files only the source has:" },
    { "Key": "GPARAM_Merge_Unmatched_TT", "Text": "These aren't in this project, so there is nothing to merge them with. Tick them and add them to copy them in whole." },
    { "Key": "GPARAM_Merge_Cannot_Add_TT", "Text": "The source doesn't say which folder this file belongs in." },
    { "Key": "GPARAM_Merge_Add_Files", "Text": "Add {0} Files to Project" },
    { "Key": "GPARAM_Merge_Add_Files_TT", "Text": "Copy the ticked files into this project, at the same path they have in the source. This can't be undone." },
    { "Key": "GPARAM_Merge_Add_Confirm_Title", "Text": "Add Files" },
    { "Key": "GPARAM_Merge_Add_Confirm_Text", "Text": "Copy {0} files into the project? This can't be undone; delete a file from the file list to remove it again." },
    { "Key": "GPARAM_Merge_Add_Confirm_Yes", "Text": "Add" },
    { "Key": "GPARAM_Merge_Add_Confirm_No", "Text": "Cancel" },

    { "Key": "GPARAM_Merge_Keep_All_Mine", "Text": "Keep All Mine" },
    { "Key": "GPARAM_Merge_Keep_All_Mine_TT", "Text": "Choose your version for every conflict." },
    { "Key": "GPARAM_Merge_Take_All_Theirs", "Text": "Take All Theirs" },
    { "Key": "GPARAM_Merge_Take_All_Theirs_TT", "Text": "Choose their version for every conflict." },
