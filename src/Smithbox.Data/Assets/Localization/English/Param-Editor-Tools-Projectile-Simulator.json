    },
    {
      "Key": "PARAM_ProjectileSimulator_Warning_Absorbed_Condition",
      "Text": "A bullet only chains when absorbing another bullet, which isn't simulated."
    },
    {
      "Key": "PARAM_ProjectileSimulator_Ignored_Homing",
