      "Text": "A bullet refers to itself, which was skipped."
    },
    {
      "Key": "PROJECTILE_Warning_Absorbed_Condition",
      "Text": "A bullet only chains when absorbing another bullet, which isn't simulated."
    },
    {
      "Key": "PROJECTILE_Ignored_Homing",
      "Text": "Homing needs a target, so this bullet flies straight."
    },
    {
      "Key": "PROJECTILE_Ignored_Emit_Position",
      "Text": "Some bullets start by the target, so these start from their source without one."
