      "Key": "PROJECTILE_Header_Setup",
      "Text": "Setup"
    },
    {
      "Key": "PROJECTILE_Launch_Height",
      "Text": "Launch Height"
    },
    {
      "Key": "PROJECTILE_Emit_Height",
      "Text": "Emit Height"
    },
    {
      "Key": "PROJECTILE_Emit_Height_TT",
      "Text": "How far above their source that bullets with an emit position of 'Higher elevation' start. The game doesn't say how much this is, and it sets the spacing of chains that hop along the ground."
    },
    {
      "Key": "PROJECTILE_Fixed_Emit_Radius",
      "Text": "Emit Radius"
    },
    {
      "Key": "PROJECTILE_Fixed_Emit_Radius_TT",
      "Text": "How far around the cast point that storm spells can emit. This game uses a fixed distance that isn't in its params, so this is an estimate."
    },
    {
      "Key": "PROJECTILE_Behind_Target_Height",
      "Text": "Behind Target Height"
    },
    {
      "Key": "PROJECTILE_Behind_Target_Distance",
      "Text": "Behind Target Distance"
    },
    {
      "Key": "PROJECTILE_Behind_Target_TT",
      "Text": "Where bullets with an emit position of 'Above and behind target' start. The params don't say how far this is, so this is an estimate."
    },
    {
      "Key": "PROJECTILE_Emitter_Duration",
      "Text": "Emitter Duration"
    },
    {
      "Key": "PROJECTILE_Emitter_Duration_TT",
      "Text": "How long the animation's bullet event lasts. While it does, a bullet with a shoot interval fires its whole volley again every interval. At 0 it fires once."
    },
    {
      "Key": "PROJECTILE_Distance_Scale",
      "Text": "Range Multiplier"
    },
    {
      "Key": "PROJECTILE_Distance_Scale_TT",
      "Text": "The range bonus of the weapon or catalyst that fires the bullet. Bullets switch to their out-of-range gravity and acceleration, and start to lose damage, past their distance times this."
    },
    {
      "Key": "PROJECTILE_Distance_Up_Effect",
      "Text": "Range Up Effect"
    },
    {
      "Key": "PROJECTILE_Distance_Up_Effect_TT",
      "Text": "Whether the shooter has the special effect that multiplies a bullet's distance by its Special Effect Distance Rate (spBulletDistUpRate)."
    },
    {
      "Key": "PROJECTILE_Cast_Orientation",
      "Text": "Cast Orientation"
    },
    {
      "Key": "PROJECTILE_Cast_Orientation_TT",
      "Text": "The way that the first bullets are pointing. In-game this comes from the casting animation rather than the row, and all of a bullet's angles are relative to it."
    },
    {
      "Key": "PROJECTILE_Orientation_Forward",
      "Text": "Forward"
    },
    {
      "Key": "PROJECTILE_Orientation_Down",
      "Text": "Down"
    },
    {
      "Key": "PROJECTILE_Orientation_Up",
      "Text": "Up"
    },
    {
      "Key": "PROJECTILE_Reroll",
      "Text": "Reroll Random Values"
    },
    {
      "Key": "PROJECTILE_Reroll_TT",
      "Text": "Bullets can vary their aim, life and creation timing. This tries another set of random values."
    },
    {
      "Key": "PROJECTILE_Ground_Collision",
      "Text": "Ground Collision"
    },
    {
      "Key": "PROJECTILE_Ground_Collision_TT",
      "Text": "Bullets that come down land on the ground. Otherwise they keep falling through it."
    },
    {
      "Key": "PROJECTILE_Simulate_Wall",
      "Text": "Wall"
    },
    {
      "Key": "PROJECTILE_Simulate_Wall_TT",
      "Text": "Places a wall in the line of fire for bullets to hit."
    },
    {
      "Key": "PROJECTILE_Simulate_Target",
      "Text": "Target"
    },
    {
      "Key": "PROJECTILE_Simulate_Target_TT",
      "Text": "Places a target for homing bullets to turn towards. Bullets that reach it count as hitting a character. The shooter still fires straight ahead."
    },
