      "Key": "PROJECTILE_Menu_Save_Params",
      "Text": "Save Params"
    },
    {
      "Key": "PROJECTILE_Menu_Save_Params_TT",
      "Text": "Saves the params, as the Param Editor does. The Projectile Editor edits the Param Editor's params, so its edits are saved with them."
    },
    {
      "Key": "PROJECTILE_Display_Fx",
      "Text": "FX"
    },
    {
      "Key": "PROJECTILE_Display_Fx_TT",
      "Text": "Plays the bullets' effects in the viewport. Flight Effects and Hit Effects pick which kinds play while this is on. Needs the FX Editor to be enabled for the project."
    },
    {
      "Key": "PROJECTILE_Display_Effects",
      "Text": "Flight Effects"
    },
    {
      "Key": "PROJECTILE_Display_Effects_TT",
      "Text": "Plays each bullet's flight effect (sfxId_Bullet) on it as it flies. Needs the FX Editor to be enabled for the project."
    },
    {
      "Key": "PROJECTILE_Display_Hit_Effects",
      "Text": "Hit Effects"
    },
    {
      "Key": "PROJECTILE_Display_Hit_Effects_TT",
      "Text": "Plays each bullet's hit effect (sfxId_Hit) where it hits the ground, the wall or the target."
    },
    {
      "Key": "PROJECTILE_Display_Trails",
      "Text": "Trails"
    },
    {
      "Key": "PROJECTILE_Display_Trails_TT",
