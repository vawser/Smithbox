    {
      "Key": "PROJECTILE_Ignored_Following",
      "Text": "Following the shooter isn't simulated."
    },
    {
      "Key": "PROJECTILE_Ignored_Arc",
      "Text": "This bullet lobs itself at a target, so without one its arc isn't worked out."
    },
    {
