    { "Name": "Large weapons", "Description": "Variant for large weapons (+200).", "Default": true, "Ids": [ 40200, 40205 ] },
    { "Name": "Polearms", "Description": "Variant for polearms (+300).", "Default": false, "Ids": [ 40300, 40305 ] },
    { "Name": "Short swords and daggers", "Description": "Variant for short swords and daggers (+2000).", "Default": false, "Ids": [ 42000, 42005 ] },
    { "Name": "Twinblades", "Description": "Variant for twinblades (+2400).", "Default": false, "Ids": [ 42400, 42405 ] },
    { "Name": "Curved swords", "Description": "Variant for curved swords (+2800).", "Default": false, "Ids": [ 42800, 42805 ] },
    { "Name": "Fists", "Description": "Variant for fists and claws (+4200).", "Default": false, "Ids": [ 44200, 44205 ] },
    { "Name": "Large shields", "Description": "Variant for large shields (+4700).", "Default": false, "Ids": [ 44700, 44705 ] },
    { "Name": "Small shields", "Description": "Variant for small shields (+4800).", "Default": false, "Ids": [ 44800, 44805 ] },
