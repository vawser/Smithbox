    { "Name": "Stance", "Description": "A stance skill: the stance and the attacks from it (in the DrawStance state machines).", "Default": false, "Ids": [ 40050, 40051, 40052, 40053, 40056, 40057, 40060, 40065, 40070, 40075 ] },
    { "Name": "Shield", "Description": "A shield skill.", "Default": false, "Ids": [ 40040, 40045 ] },
